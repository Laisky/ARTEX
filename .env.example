# Docker 部署配置（复制为 .env）
COMPOSE_PROJECT_NAME=artex
ARTEX_TAG=local
# 必须使用本机 Tailscale IPv4（tailscale ip -4），不要用 0.0.0.0。
ARTEX_BIND_IP=127.0.0.1
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex_local

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
